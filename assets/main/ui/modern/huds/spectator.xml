							<use template="arena-roster" team="allies" side="left" />
							<container width="auto" height="auto" fill="{var.fill-transparent}" visible="{cvar.cg_gametype &gt; 1 and cvar.ui_om_hud_allied_score != ''}">
								<use template="arena-score-box" box-fill="{var.fill-hud-allied-score}" bind="cvar:ui_om_hud_allied_score" />
							</container>
							<container width="auto" height="auto" fill="{var.fill-transparent}" visible="{cvar.cg_gametype == 1 and cvar.ui_om_hud_score_self != ''}">
								<use template="arena-score-box" box-fill="{var.fill-panel}" bind="cvar:ui_om_hud_score_self" />
							</container>
							<use template="arena-timer-box" />
							<container width="auto" height="auto" fill="{var.fill-transparent}" visible="{cvar.cg_gametype &gt; 1 and cvar.ui_om_hud_axis_score != ''}">
								<use template="arena-score-box" box-fill="{var.fill-hud-axis-score}" bind="cvar:ui_om_hud_axis_score" />
							</container>
							<container width="auto" height="auto" fill="{var.fill-transparent}" visible="{cvar.cg_gametype == 1 and cvar.ui_om_hud_score_leader != ''}">
								<use template="arena-score-box" box-fill="{var.fill-panel}" bind="cvar:ui_om_hud_score_leader" />
							</container>
							<use template="arena-roster" team="axis" side="right" />
						</container>
					</container>
<container id="hud_top_row_right" type="horizontal" width="fill" height="100%" halign="end" valign="start"/>
</container>
<container id="hud_middle_row" type="horizontal" width="fill" height="fill" halign="start" valign="start">
<container id="hud_middle_row_left" type="vertical" width="fill" height="100%" gap="16px"
           halign="start" valign="start" fill="{var.fill-transparent}">
<use template="hud-game-messages-panel" width="{22.5 * cvar.ui_om_hud_messages_size}px"
     height="{7.5 * cvar.ui_om_hud_messages_size}px" font-size="{cvar.ui_om_hud_messages_size}px"/>
</container>
<container id="hud_middle_row_right" type="vertical" width="fill" height="100%"
           halign="end" valign="start" fill="{var.fill-transparent}"/>
</container>
<container id="hud_bottom_row" type="horizontal" width="100%" height="auto" valign="end">
<container id="hud_bottom_row_left" type="vertical" width="fill" height="auto" gap="12px"
           halign="start" valign="end" fill="{var.fill-transparent}">
<use id="arena_chat" template="hud-chat-panel" width="{22.5 * cvar.ui_om_hud_chat_size}px"
     height="{10 * cvar.ui_om_hud_chat_size}px" font-size="{cvar.ui_om_hud_chat_size}px"/>
<container type="vertical" width="300px" height="auto" gap="0px"
           fill="{var.fill-transparent}">
<container id="spectator_list_left" type="vertical" width="300px" height="auto" gap="0px"
           source="scoreboard" fill="{var.fill-transparent}" visible="{cvar.ui_om_hud_show}">
<foreach mode="all" type="vertical" width="300px" height="auto" gap="0px">
<use template="spectator-row-left"/>
</foreach>
</container>
<container width="300px" height="34px" fill="{var.fill-transparent}"/>
</container>
</container>
<container id="hud_bottom_row_center" type="vertical" width="50%" height="auto" gap="10px"
           halign="center" valign="end">
<label font="body" font-size="18px" width="100%" height="auto" halign="center" valign="center"
       text-wrap="word" color="{var.color-white}" drop-shadow="true"
       visible="{cvar.ui_om_hud_centerprint != ''}"
       bind="cvar:ui_om_hud_centerprint">{cvar.ui_om_hud_centerprint}</label>
<container id="spectator_following" type="vertical" width="auto" height="auto" gap="6px"
           halign="center" valign="end" fill="{var.fill-transparent}"
           visible="{cvar.ui_om_hud_show and cvar.ui_om_hud_following_name != ''}">
<label id="spectated_player_name" font="body" font-size="26px" font-weight="700"
       width="auto" height="auto" halign="center" valign="center" drop-shadow="true"
       color="{var.color-white}"
       bind="cvar:ui_om_hud_following_name"/>
<container type="horizontal" width="auto" height="auto" gap="10px" halign="center" valign="center"
           fill="{var.fill-transparent}">
<container type="overlap" width="304px" height="14px" padding="0" fill="{var.fill-panel}"
           stroke="{var.fill-divider}" stroke-width="1px" crisp="true">
<container width="{300 * clamp(cvar.ui_om_hud_health_frac, 0, 1)}px" height="10px" margin="2px"
           halign="start" valign="start"
           fill="{cvar.ui_om_hud_following_team == &quot;axis&quot; ? var.fill-hud-axis-score : var.fill-hud-allied-score}"/>
</container>
<label font="body" font-size="18px" font-weight="600" width="40px" height="auto" halign="start"
       valign="center" color="{var.color-white}" drop-shadow="true"
       bind="cvar:ui_om_hud_health">{cvar.ui_om_hud_health}</label>
</container>
</container>
</container>
<container id="hud_bottom_row_right" type="vertical" width="fill" height="auto"
           halign="end" valign="end" fill="{var.fill-transparent}">
<container type="vertical" width="300px" height="auto" gap="0px"
           fill="{var.fill-transparent}">
<container id="spectator_list_right" type="vertical" width="300px" height="auto" gap="0px"
           source="scoreboard" fill="{var.fill-transparent}" visible="{cvar.ui_om_hud_show}">
<foreach mode="all" type="vertical" width="300px" height="auto" gap="0px">
<use template="spectator-row-right"/>
</foreach>
</container>
<container width="300px" height="34px" fill="{var.fill-transparent}"/>
</container>
</container>
</container>
</container>
<container id="hud_killfeed_parent" type="horizontal" width="100%" height="100%" padding="32px"
           halign="end" valign="start" fill="{var.fill-transparent}">
<use template="spectator-kill-feed"/>
</container>
<container id="hud_stopwatch_parent" type="vertical" width="100%" height="100%" halign="center"
           valign="center" padding="16px">
<container id="hud_stopwatch_container_top" type="vertical" width="100%" height="50%"
           halign="center" valign="center"/>
<container id="hud_stopwatch_container_bottom" type="vertical" width="100%" height="50%"
           halign="center" valign="center">
<container type="horizontal" width="{300 * cvar.ui_om_hud_stopwatch_frac}px" height="24px"
           margin="0 0 0 0" halign="center" valign="center"
           fill="{var.fill-hud-stopwatch}" visible="{cvar.ui_om_hud_stopwatch_ms > 0}"/>
</container>
</container>
</container>
</canvas>
