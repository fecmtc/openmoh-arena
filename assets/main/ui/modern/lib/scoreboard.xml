<ui-library version="1">
	<!-- Added in MoH Arena: the colours and the image of the player rows -->
	<vars>
		<var id="fill-scoreboard-row" value="#1A1A1A66"/>
		<var id="fill-scoreboard-row-local" value="#FFFFFF2E"/>
		<var id="fill-scoreboard-alive-allied" value="#8891CCFF"/>
		<var id="fill-scoreboard-alive-axis" value="#CC8888FF"/>
		<var id="fill-scoreboard-dead" value="#2A1416FF"/>
		<var id="color-scoreboard-dead" value="#EBF0F580"/>
	</vars>
	<images>
		<image id="scoreboard-skull" src="ui/modern/textures/modernhud/skull_50.png"/>
	</images>
	<templates>
		<template id="scoreboard-server-header">
			<container type="vertical" width="100%" height="auto" fill="{var.fill-transparent}" gap="0">
				<container type="horizontal" width="100%" height="48px" fill="{var.fill-input}" gap="0"
				           valign="center" halign="start">
					<container width="auto" height="100%" padding="0 26px 0px 20px"
					           shape="skew-rect" skewl="0px" skewr="12px"
					           fill="{var.color-accent}" valign="center" halign="center">
						<label width="auto" font="control" font-size="{var.text-control}" letter-spacing="2px"
						       color="{var.color-white}" halign="start"
						       bind="cvar:ui_om_scoreboard_gamemode"/>
					</container>
					<container width="2px" height="100%" margin="0 -6px 0 -6px" fill="{var.fill-divider-skew}"
					           shape="angled-line" offset="12px" heightfactor="0.64"/>
					<label width="fill" height="100%" padding="0 12px 0 16px"
					       font="control" font-size="{var.text-control}" color="{var.color-primary}"
					       halign="start" valign="center"
					       bind="cvar:ui_om_scoreboard_server_name"/>
				</container>
				<container width="100%" height="1px" fill="{var.fill-divider}"/>
			</container>
		</template>

		<template id="scoreboard-sort-header">
			<props>
				<prop name="label" type="string" required="true"/>
				<prop name="column" type="string" required="true"/>
				<prop name="width" type="string" required="true"/>
				<prop name="halign" type="string" default="start"/>
			</props>
			<button type="horizontal" width="{template.width}" height="100%" padding="0" gap="4px"
			        halign="{template.halign}" valign="center"
			        fill="{var.fill-transparent}" hoverfill="{var.fill-chip}">
				<label font="control" font-size="{var.text-caption}" color="{var.color-muted}"
				       halign="{template.halign}">{template.label}</label>
				<container width="10px" height="12px" visible="{cvar.ui_om_scoreboard_sort == {template.column}}">
					<container width="8px" height="12px" shape="arrow-left" thickness="3px" fill="{var.color-accent}"
					           shape-rotation="-90" visible="{cvar.ui_om_scoreboard_sort_asc == 1}"/>
					<container width="8px" height="12px" shape="arrow-left" thickness="3px" fill="{var.color-accent}"
					           shape-rotation="90" visible="{cvar.ui_om_scoreboard_sort_asc == 0}"/>
				</container>
				<on event="click">
					<set-cvar name="ui_om_scoreboard_sort" value="{template.column}"/>
					<invoke name="sort-scoreboard"/>
				</on>
			</button>
		</template>

		<!-- Changed in MoH Arena: one column order for every table (ID NAME ... PING) and the
		     player's number in every game. Omaha mirrored the Axis table and showed the
		     number in team games only.
		     In the games played in rounds (game type 3 and up) the server counts no deaths:
		     KILLS is the kills of this round and the next column is the kills of the whole
		     match. So that column is named TOTAL there, as on the stock scoreboard, and
		     there is no K/D column. -->
		<template id="scoreboard-column-header-row">
			<container type="vertical" width="100%" height="auto" fill="{var.fill-control}">
				<container type="horizontal" width="100%" height="36px" padding="8px 12px" gap="8px"
				           valign="center" halign="start">
					<label width="6%" font="control" font-size="{var.text-caption}" color="{var.color-muted}"
					       halign="start">ID</label>
					<use template="scoreboard-sort-header" label="NAME" column="name" width="fill" halign="start"/>
					<use template="scoreboard-sort-header" label="KILLS" column="kills" width="9%" halign="start"/>
					<use template="scoreboard-sort-header" label="DEATHS" column="deaths" width="10%" halign="start"
					     visible="{cvar.ui_om_scoreboard_gametype &lt; 3}"/>
					<use template="scoreboard-sort-header" label="TOTAL" column="deaths" width="10%" halign="start"
					     visible="{cvar.ui_om_scoreboard_gametype >= 3}"/>
					<use template="scoreboard-sort-header" label="K/D" column="kd" width="9%" halign="start"
					     visible="{cvar.ui_om_scoreboard_gametype &lt; 3}"/>
					<use template="scoreboard-sort-header" label="TIME" column="time" width="12%" halign="start"/>
					<use template="scoreboard-sort-header" label="PING" column="ping" width="8%" halign="start"/>
				</container>
				<container width="100%" height="1px" fill="{var.color-accent}"/>
			</container>
		</template>

		<!-- Allies banner: name outer-left, score toward spine -->
		<template id="scoreboard-team-banner-allied">
			<container type="horizontal" width="100%" height="40px" padding="0 12px" gap="8px"
			           fill="{var.fill-hud-allied-score}" valign="center" halign="start">
				<label width="fill" font="control" font-size="{var.text-control}" letter-spacing="2px"
				       color="{var.color-white}" halign="start" valign="center">ALLIES</label>
				<label width="auto" font="control" font-size="{var.text-heading}"
				       color="{var.color-white}" halign="end" valign="center"
				       bind="cvar:ui_om_hud_allied_score"/>
			</container>
		</template>

		<!-- Axis banner: score toward spine, name outer-right -->
		<template id="scoreboard-team-banner-axis">
			<container type="horizontal" width="100%" height="40px" padding="0 12px" gap="8px"
			           fill="{var.fill-hud-axis-score}" valign="center" halign="end">
				<label width="auto" font="control" font-size="{var.text-heading}"
				       color="{var.color-white}" halign="start" valign="center"
				       bind="cvar:ui_om_hud_axis_score"/>
				<label width="fill" font="control" font-size="{var.text-control}" letter-spacing="2px"
				       color="{var.color-white}" halign="end" valign="center">AXIS</label>
			</container>
		</template>

		<!-- Free-for-all row. Nobody is told who is alive there, so the row has no mark for it.
		     Changed in MoH Arena: the own row has a light fill and an accent edge. -->
		<template id="scoreboard-row">
			<!-- height 29px + overflow=hidden matches foreach row-height; clips overscan paints. -->
			<container type="vertical" width="100%" height="29px" overflow="hidden"
			           fill="{var.fill-transparent}"
			           visible="{item.field.is_spectator != 1}">
				<container type="horizontal" width="100%" height="28px" gap="0"
				           valign="center" halign="start"
				           fill="{item.field.is_local == 1 ? var.fill-scoreboard-row-local : var.fill-scoreboard-row}">
					<container width="3px" height="100%"
					           fill="{item.field.is_local == 1 ? var.color-accent : var.fill-transparent}"/>
					<container type="horizontal" width="fill" height="100%" padding="0 12px 0 9px" gap="8px"
					           valign="center" halign="start" fill="{var.fill-transparent}">
						<label width="100%" height="100%" font="control"
						       font-size="{var.text-body}"
						       letter-spacing="1px" color="{var.color-primary}"
						       halign="start" valign="center"
						       visible="{item.field.is_header == 1}">{item.field.name}</label>
						<container type="horizontal" width="100%" height="100%" gap="8px"
						           valign="center" halign="start"
						           visible="{item.field.is_header == 0}">
							<label width="6%" height="100%" font="body"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.slot}</label>
							<label width="fill" height="100%" font="body" text-overflow="ellipsis"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.name}</label>
							<label width="9%" height="100%" font="body"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.kills}</label>
							<label width="10%" height="100%" font="body"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.deaths}</label>
							<label width="9%" height="100%" font="body"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.kd}</label>
							<label width="12%" height="100%" font="body"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.time}</label>
							<label width="8%" height="100%" font="body"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{var.color-primary}"
							       halign="start" valign="center">{item.field.ping}</label>
						</container>
					</container>
				</container>
				<container width="100%" height="1px" fill="{var.fill-divider}"/>
			</container>
		</template>

		<!-- Team row, the same for both teams (filter by team).
		     Changed in MoH Arena: the own row has a light fill and an accent edge. A living
		     player has a square in the team's colour; a dead one a dark square with a skull,
		     dim text and a DEAD tag, like the squares of the HUD's top bar. The game sends
		     this in team games only, and the stock scoreboard shows it with a text colour. -->
		<template id="scoreboard-team-player-row">
			<props>
				<prop name="team" type="string" required="true"/>
			</props>
			<container type="vertical" width="100%" height="29px" overflow="hidden"
			           fill="{var.fill-transparent}"
			           visible="{item.field.is_spectator != 1 and item.field.is_header != 1 and item.field.team == {template.team}}">
				<container type="horizontal" width="100%" height="28px" gap="0"
				           valign="center" halign="start"
				           fill="{item.field.is_local == 1 ? var.fill-scoreboard-row-local : var.fill-scoreboard-row}">
					<container width="3px" height="100%"
					           fill="{item.field.is_local == 1 ? var.color-accent : var.fill-transparent}"/>
					<container type="horizontal" width="fill" height="100%" padding="0 12px 0 9px" gap="8px"
					           valign="center" halign="start" fill="{var.fill-transparent}">
						<label width="6%" height="100%" font="body"
						       font-size="{var.text-body}"
						       font-weight="{item.field.is_local == 1 ? 600 : 400}"
						       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
						       halign="start" valign="center">{item.field.slot}</label>
						<!-- The space at the right keeps the DEAD tag apart from the kills. -->
						<container type="horizontal" width="fill" height="100%" gap="8px" padding="0 24px 0 0"
						           valign="center" halign="start" fill="{var.fill-transparent}">
							<container width="16px" height="16px"
							           visible="{item.field.is_dead != 1}"
							           fill="{template.team == allies ? var.fill-scoreboard-alive-allied : var.fill-scoreboard-alive-axis}"
							           stroke="{var.fill-divider}" stroke-width="1px" crisp="true"/>
							<container type="overlap" width="16px" height="16px" padding="1px"
							           halign="center" valign="center"
							           visible="{item.field.is_dead == 1}"
							           fill="{var.fill-scoreboard-dead}"
							           stroke="{var.color-danger}" stroke-width="1px" crisp="true">
								<image src="scoreboard-skull" width="100%" height="100%" fit="contain"
								       halign="center" valign="center"/>
							</container>
							<label width="fill" height="100%" font="body" text-overflow="ellipsis"
							       font-size="{var.text-body}"
							       font-weight="{item.field.is_local == 1 ? 600 : 400}"
							       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
							       halign="start" valign="center">{item.field.name}</label>
							<label width="auto" height="100%" font="control"
							       font-size="{var.text-caption}" letter-spacing="1px"
							       color="{var.color-danger}" halign="end" valign="center"
							       visible="{item.field.is_dead == 1}">DEAD</label>
						</container>
						<label width="9%" height="100%" font="body"
						       font-size="{var.text-body}"
						       font-weight="{item.field.is_local == 1 ? 600 : 400}"
						       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
						       halign="start" valign="center">{item.field.kills}</label>
						<label width="10%" height="100%" font="body"
						       font-size="{var.text-body}"
						       font-weight="{item.field.is_local == 1 ? 600 : 400}"
						       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
						       halign="start" valign="center">{item.field.deaths}</label>
						<label width="9%" height="100%" font="body"
						       font-size="{var.text-body}"
						       font-weight="{item.field.is_local == 1 ? 600 : 400}"
						       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
						       halign="start" valign="center" visible="{cvar.ui_om_scoreboard_gametype &lt; 3}">{item.field.kd}</label>
						<label width="12%" height="100%" font="body"
						       font-size="{var.text-body}"
						       font-weight="{item.field.is_local == 1 ? 600 : 400}"
						       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
						       halign="start" valign="center">{item.field.time}</label>
						<label width="8%" height="100%" font="body"
						       font-size="{var.text-body}"
						       font-weight="{item.field.is_local == 1 ? 600 : 400}"
						       color="{item.field.is_dead == 1 ? var.color-scoreboard-dead : var.color-primary}"
						       halign="start" valign="center">{item.field.ping}</label>
					</container>
				</container>
				<container width="100%" height="1px" fill="{var.fill-divider}"/>
			</container>
		</template>

		<!-- Spectator row. The shipped scoreboard lists the spectators in one line instead. -->
		<template id="scoreboard-spectator-row">
			<container type="vertical" width="100%" height="29px" overflow="hidden"
			           fill="{var.fill-transparent}"
			           visible="{item.field.is_spectator == 1}">
				<container type="horizontal" width="100%"
				           height="28px"
				           padding="0 12px" gap="8px" valign="center" halign="start"
				           fill="{item.field.row_fill}">
					<label width="6%" height="100%" font="body"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center">{item.field.slot}</label>
					<label width="fill" height="100%" font="body" text-overflow="ellipsis"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center">{item.field.name}</label>
					<label width="9%" height="100%" font="body"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center">{item.field.kills}</label>
					<label width="10%" height="100%" font="body"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center">{item.field.deaths}</label>
					<label width="9%" height="100%" font="body"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center" visible="{cvar.ui_om_scoreboard_gametype &lt; 3}">{item.field.kd}</label>
					<label width="12%" height="100%" font="body"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center">{item.field.time}</label>
					<label width="8%" height="100%" font="body"
					       font-size="{var.text-body}"
					       font-weight="{item.field.is_local == 1 ? 600 : 400}"
					       color="{var.color-primary}"
					       halign="start" valign="center">{item.field.ping}</label>
				</container>
				<container width="100%" height="1px" fill="{var.fill-divider}"/>
			</container>
		</template>
	</templates>
</ui-library>
