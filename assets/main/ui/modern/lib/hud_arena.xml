<ui-library version="1">
	<!--
	  MoH Arena: the parts of the "Arena" HUD style that the other styles do not
	  have. The compass and the top bar are the ones of the competitive style
	  with every size multiplied by a player setting. The health bar, the vote
	  prompt, the name under the crosshair and the voice menu are the ones of
	  the classic style with their values written out, so that the style needs
	  the modern theme only.

	  This file imports nothing: huds/arena.xml imports the theme, the tokens,
	  the shapes and the images before it.

	  A size that follows a setting names the cvar itself. A template prop
	  cannot carry such a size: the text of the prop would be pasted into the
	  arithmetic of the template.

	  A value with more than one part writes every part in braces
	  ("{a}px {0}px {0}px {0}px"). With one brace only, the parts after it are
	  dropped when the value is worked out at run time.
	-->
	<templates>
		<!--
		  A bearing on the rim of the dial. The origin is given in percent of the
		  label's own box, so it follows the size setting by itself: the centre of
		  the dial is half a label to the right and 78/16 of a label below its top.
		-->
		<template id="arena-compass-bearing">
			<props>
				<prop name="bearing" type="number" required="true"/>
				<prop name="label" type="string" required="true"/>
			</props>
			<label font="body" font-size="{13 * cvar.ui_om_hud_compass_scale}px" font-weight="600"
			       width="{36 * cvar.ui_om_hud_compass_scale}px" height="{16 * cvar.ui_om_hud_compass_scale}px"
			       halign="center" valign="start"
			       margin="{2 * cvar.ui_om_hud_compass_scale}px {0}px {0}px {0}px"
			       color="{var.color-white}" drop-shadow="true"
			       rotation="{cvar.ui_om_hud_compass_heading + template.bearing}"
			       rotation-origin="50% 487.5%">
				{template.label}
			</label>
		</template>

		<!-- The round compass of the competitive style, 160px wide at size 1. -->
		<template id="arena-compass">
			<container type="overlap" width="{160 * cvar.ui_om_hud_compass_scale}px"
			           height="{160 * cvar.ui_om_hud_compass_scale}px" padding="0"
			           fill="{var.fill-transparent}"
			           visible="{cvar.ui_compass > 0}">
				<container width="{160 * cvar.ui_om_hud_compass_scale}px"
				           height="{160 * cvar.ui_om_hud_compass_scale}px" shape="circle"
				           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px" crisp="true"/>
				<!-- Where the damage came from, cut to the circle by the mask. -->
				<container type="overlap" width="{160 * cvar.ui_om_hud_compass_scale}px"
				           height="{160 * cvar.ui_om_hud_compass_scale}px" padding="0"
				           fill="{var.fill-transparent}"
				           mask-image="radial(50% 50%, #FFFFFFFF 0%, #FFFFFFFF 99%, #FFFFFF00 100%)">
					<container width="{160 * cvar.ui_om_hud_compass_scale}px"
					           height="{160 * cvar.ui_om_hud_compass_scale}px"
					           shape="compass-pain-wedge"
					           fill="{var.color-hud-low-health-pip}"
					           rotation="{cvar.ui_om_hud_damage_angle}"
					           opacity="{cvar.ui_om_hud_damage_alpha}"/>
				</container>
				<use template="arena-compass-bearing" bearing="0" label="N"/>
				<use template="arena-compass-bearing" bearing="45" label="NE"/>
				<use template="arena-compass-bearing" bearing="90" label="E"/>
				<use template="arena-compass-bearing" bearing="135" label="SE"/>
				<use template="arena-compass-bearing" bearing="180" label="S"/>
				<use template="arena-compass-bearing" bearing="225" label="SW"/>
				<use template="arena-compass-bearing" bearing="270" label="W"/>
				<use template="arena-compass-bearing" bearing="315" label="NW"/>
				<!-- The objective: half outside the rim. Origin y = (80 + 6) / 12 of the dot. -->
				<container width="{12 * cvar.ui_om_hud_compass_scale}px"
				           height="{12 * cvar.ui_om_hud_compass_scale}px" shape="circle"
				           valign="start" halign="center"
				           margin="{0 - 6 * cvar.ui_om_hud_compass_scale}px {0}px {0}px {0}px"
				           fill="{var.color-hud-compass-obj-primary}"
				           stroke="{var.fill-divider}" stroke-width="1px" crisp="true"
				           rotation="{cvar.ui_om_hud_obj_arrow_angle}"
				           rotation-origin="50% 716.667%"
				           visible="{cvar.ui_om_hud_obj_arrow_visible > 0}"/>
				<!-- The two secondary objectives. Origin y = (80 + 5) / 10 of the dot. -->
				<container width="{10 * cvar.ui_om_hud_compass_scale}px"
				           height="{10 * cvar.ui_om_hud_compass_scale}px" shape="circle"
				           valign="start" halign="center"
				           margin="{0 - 5 * cvar.ui_om_hud_compass_scale}px {0}px {0}px {0}px"
				           fill="{var.color-hud-compass-obj-ball}"
				           stroke="{var.fill-divider}" stroke-width="1px" crisp="true"
				           rotation="{cvar.ui_om_hud_obj_left_angle}"
				           rotation-origin="50% 850%"
				           visible="{cvar.ui_om_hud_obj_left_visible > 0}"/>
				<container width="{10 * cvar.ui_om_hud_compass_scale}px"
				           height="{10 * cvar.ui_om_hud_compass_scale}px" shape="circle"
				           valign="start" halign="center"
				           margin="{0 - 5 * cvar.ui_om_hud_compass_scale}px {0}px {0}px {0}px"
				           fill="{var.color-hud-compass-obj-ball}"
				           stroke="{var.fill-divider}" stroke-width="1px" crisp="true"
				           rotation="{cvar.ui_om_hud_obj_right_angle}"
				           rotation-origin="50% 850%"
				           visible="{cvar.ui_om_hud_obj_right_visible > 0}"/>
				<!-- The frame at the top: what is inside it is straight ahead. -->
				<container width="{22 * cvar.ui_om_hud_compass_scale}px"
				           height="{22 * cvar.ui_om_hud_compass_scale}px"
				           halign="center" valign="start"
				           margin="{2 * cvar.ui_om_hud_compass_scale}px {0}px {0}px {0}px"
				           fill="{var.fill-transparent}"
				           stroke="{var.color-white}" stroke-width="1px" crisp="true"/>
			</container>
		</template>

		<!--
		  The players of one team as squares, from the scoreboard rows: the team's
		  colour for a living player, dark with a skull for a dead one. The living
		  ones are next to the score.

		  A square is 32px at size 1. With more than 12 players in the larger
		  team it shrinks, so that both teams and the boxes stay inside the middle
		  half of the screen: 12 x 32 = 384 a side.
		-->
		<template id="arena-roster">
			<props>
				<prop name="team" type="string" required="true"/>
				<prop name="side" type="string" required="true"/>
			</props>
			<container type="horizontal" width="auto"
			           height="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale}px"
			           gap="0" source="scoreboard" fill="{var.fill-transparent}"
			           valign="center" halign="center"
			           visible="{cvar.cg_gametype >= 3 and cvar.cg_gametype &lt;= 4}">
				<container type="horizontal" width="auto" height="100%" gap="0"
				           fill="{var.fill-transparent}" visible="{template.side == left}">
					<foreach mode="all" type="horizontal" width="auto" height="100%" gap="0">
						<use template="arena-roster-dead" team="{template.team}"/>
					</foreach>
					<foreach mode="all" type="horizontal" width="auto" height="100%" gap="0">
						<use template="arena-roster-alive" team="{template.team}"/>
					</foreach>
				</container>
				<container type="horizontal" width="auto" height="100%" gap="0"
				           fill="{var.fill-transparent}" visible="{template.side == right}">
					<foreach mode="all" type="horizontal" width="auto" height="100%" gap="0">
						<use template="arena-roster-alive" team="{template.team}"/>
					</foreach>
					<foreach mode="all" type="horizontal" width="auto" height="100%" gap="0">
						<use template="arena-roster-dead" team="{template.team}"/>
					</foreach>
				</container>
			</container>
		</template>

		<template id="arena-roster-alive">
			<props>
				<prop name="team" type="string" required="true"/>
			</props>
			<container width="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale}px"
			           height="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale}px"
			           visible="{item.field.is_header != 1 and item.field.is_spectator != 1 and item.field.team == {template.team} and item.field.is_dead != 1}"
			           fill="{template.team == allies ? var.fill-hud-roster-allied : var.fill-hud-roster-axis}"
			           stroke="{var.fill-divider}" stroke-width="1px" crisp="true"/>
		</template>

		<template id="arena-roster-dead">
			<props>
				<prop name="team" type="string" required="true"/>
			</props>
			<container type="overlap"
			           width="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale}px"
			           height="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale}px"
			           padding="0" halign="center" valign="center"
			           visible="{item.field.is_header != 1 and item.field.is_spectator != 1 and item.field.team == {template.team} and item.field.is_dead == 1}"
			           fill="{template.team == allies ? var.fill-hud-roster-allied-dead : var.fill-hud-roster-axis-dead}"
			           stroke="{var.fill-divider}" stroke-width="1px" crisp="true">
				<image src="modernhud-skull-50"
				       width="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale * 0.5625}px"
				       height="{min(32, 384 / max(1, cvar.ui_om_hud_roster_max)) * cvar.ui_om_hud_topbar_scale * 0.5625}px"
				       fit="contain" opacity="0.5" halign="center" valign="center"/>
			</container>
		</template>

		<!-- A score box of the top bar, 40 x 32 at size 1. -->
		<template id="arena-score-box">
			<props>
				<prop name="box-fill" type="string" required="true"/>
				<prop name="bind" type="binding" required="true"/>
			</props>
			<container type="horizontal" width="{40 * cvar.ui_om_hud_topbar_scale}px"
			           height="{32 * cvar.ui_om_hud_topbar_scale}px" gap="0" padding="0"
			           halign="center" valign="center"
			           fill="{template.box-fill}"
			           stroke="{var.fill-divider}" stroke-width="1px" crisp="true">
				<label font="body" font-size="{16 * cvar.ui_om_hud_topbar_scale}px" color="{var.color-white}"
				       drop-shadow="true" width="100%" height="100%" halign="center" valign="center"
				       bind="{template.bind}"/>
			</container>
		</template>

		<!-- The time left as M:SS, 64 x 32 at size 1. -->
		<template id="arena-timer-box">
			<container type="horizontal" width="{64 * cvar.ui_om_hud_topbar_scale}px"
			           height="{32 * cvar.ui_om_hud_topbar_scale}px" gap="0" padding="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}"
			           stroke="{var.fill-divider}" stroke-width="1px" crisp="true"
			           visible="{cvar.ui_om_hud_time_seconds != ''}">
				<label font="body" font-size="{16 * cvar.ui_om_hud_topbar_scale}px" color="{var.color-white}"
				       drop-shadow="true" width="auto" height="auto" halign="end" valign="center">
					{floor(cvar.ui_om_hud_time_seconds / 60)}:
				</label>
				<label font="body" font-size="{16 * cvar.ui_om_hud_topbar_scale}px" color="{var.color-white}"
				       drop-shadow="true" width="auto" height="auto" halign="start" valign="center"
				       visible="{cvar.ui_om_hud_time_seconds % 60 &lt; 10}">
					0
				</label>
				<label font="body" font-size="{16 * cvar.ui_om_hud_topbar_scale}px" color="{var.color-white}"
				       drop-shadow="true" width="auto" height="auto" halign="start" valign="center">
					{floor(cvar.ui_om_hud_time_seconds % 60)}
				</label>
			</container>
		</template>

		<!--
		  The kill feed of the other styles with the text size of a setting. The
		  weapon and the two marks keep their proportion to the text (20 and 18
		  for a 16px text), and so does the box (420 x 140). The two names have
		  the row's colour, as in the shared panel.
		-->
		<template id="arena-kill-feed-panel">
			<container type="vertical" width="{26.25 * cvar.ui_om_hud_killfeed_size}px"
			           height="{8.75 * cvar.ui_om_hud_killfeed_size}px" gap="3px" padding="0"
			           fill="{var.fill-transparent}" halign="end" source="hud-kill-feed">
				<foreach mode="all" lifetime="6s" fade-duration="1.5s" halign="end">
					<container type="horizontal" width="auto" height="auto" gap="6px" valign="center" halign="end"
					           fill="{var.fill-transparent}">
						<label font="body" font-size="{cvar.ui_om_hud_killfeed_size}px" width="auto" halign="end" drop-shadow="true"
						       color="{item.field.color}"
						       visible="{item.field.killer != ''}">
							{item.field.killer}
						</label>
						<image src="{item.field.weapon_image}" height="{cvar.ui_om_hud_killfeed_size * 1.25}px"
						       width="auto" fit="contain"/>
						<image src="modernhud-skull-50" height="{cvar.ui_om_hud_killfeed_size * 1.125}px"
						       width="auto" fit="contain"
						       visible="{item.field.kill_kind == &quot;suicide&quot;}"/>
						<image src="modernhud-headshot-50" height="{cvar.ui_om_hud_killfeed_size * 1.125}px"
						       width="auto" fit="contain"
						       visible="{item.field.headshot == 1}"/>
						<label font="body" font-size="{cvar.ui_om_hud_killfeed_size}px" width="auto" halign="start" drop-shadow="true"
						       color="{item.field.color}">
							{item.field.victim}
						</label>
					</container>
				</foreach>
			</container>
		</template>

		<!-- The health bar of the classic style. -->
		<template id="arena-health-panel">
			<container type="horizontal" width="auto" height="auto" gap="7.5px" valign="end">
				<container type="overlap" width="20px" height="80px" padding="0" fill="{var.fill-transparent}">
					<container width="20px" height="80px" background-image="hud-healthback"
					           background-fit="stretch"/>
					<container width="20px" height="80px" background-image="hud-healthmeter"
					           background-fit="stretch" shape="edge-clip" left="0"
					           top="{cvar.ui_om_hud_health_top}" right="1" bottom="1"/>
					<container width="20px" height="80px" background-image="hud-healthmeter-flash"
					           background-fit="stretch" shape="edge-clip" left="0"
					           top="{cvar.ui_om_hud_health_top}" right="1" bottom="1"
					           opacity="{cvar.ui_om_hud_damage_alpha}"
					           visible="{cvar.ui_om_hud_damage_alpha > 0.02}"/>
				</container>
				<container type="vertical" width="auto" height="auto" gap="2.5px" valign="end">
					<label font="body" font-size="17.5px" color="#B39A0DFF" halign="start">Health</label>
					<label font="body" font-size="17.5px" color="{var.color-white}" halign="start"
					       bind="cvar:ui_om_hud_health">{cvar.ui_om_hud_health}</label>
				</container>
			</container>
		</template>

		<!-- The name and health of the player under the crosshair. Not shown while
		     following a player as spectator: the server reports the followed player
		     in the same value the whole time, and this style already names that
		     player above the health bar, which shows that player's health.
		     Not shown while the scoreboard is up either: the HUD is drawn over the
		     scoreboard, and this tag sits in the middle of it. -->
		<template id="arena-target-info-panel">
			<container type="horizontal" width="auto" height="auto" gap="7.5px" valign="center"
			           visible="{cvar.ui_om_hud_info_health > 0 and cvar.ui_om_hud_following_text == '' and cvar.ui_om_scoreboard_open != 1}">
				<container width="20px" height="20px" background-image="hud-allies"
				           background-fit="stretch" visible="{cvar.ui_om_hud_info_team == 3}"/>
				<container width="20px" height="20px" background-image="hud-axis"
				           background-fit="stretch" visible="{cvar.ui_om_hud_info_team == 4}"/>
				<container type="vertical" width="auto" height="auto" gap="2.5px">
					<label font="body" font-size="17.5px" drop-shadow="true"
					       color="{cvar.ui_om_hud_info_friendly ? var.color-hud-friendly : var.color-hud-enemy}"
					       bind="cvar:ui_om_hud_info_name">{cvar.ui_om_hud_info_name}</label>
					<label font="body" font-size="17.5px" drop-shadow="true"
					       color="{cvar.ui_om_hud_info_friendly ? var.color-hud-friendly : var.color-hud-enemy}"
					       bind="cvar:ui_om_hud_info_health">{cvar.ui_om_hud_info_health}</label>
				</container>
			</container>
		</template>

		<!-- A vote in progress: what is voted on, the count and the keys. -->
		<template id="arena-vote-panel">
			<container type="vertical" width="420px" height="auto" gap="5px"
			           visible="{cvar.ui_om_hud_vote_seconds > 0}" fill="{var.fill-panel}" padding="5px 10px">
				<label font="body" font-size="16px" color="{var.color-white}" width="100%"
				       bind="cvar:ui_om_hud_vote_text" text-wrap="word">{cvar.ui_om_hud_vote_text}</label>
				<label font="body" font-size="16px" color="{var.color-white}"
				       bind="cvar:ui_om_hud_vote_stats">{cvar.ui_om_hud_vote_stats}</label>
				<label font="body" font-size="16px" color="{var.color-hud-friendly}" width="100%" text-wrap="word"
				       visible="{cvar.ui_om_hud_vote_prompt != ''}"
				       bind="cvar:ui_om_hud_vote_prompt">{cvar.ui_om_hud_vote_prompt}</label>
				<label font="body" font-size="16px" color="{var.color-hud-friendly}"
				       visible="{cvar.ui_om_hud_vote_keys != ''}"
				       bind="cvar:ui_om_hud_vote_keys">{cvar.ui_om_hud_vote_keys}</label>
			</container>
		</template>

		<!-- The voice message menu: the game names the picture to show. -->
		<template id="arena-im-panel">
			<image src="{cvar.ui_om_hud_im_image}" width="auto" height="auto" fit="stretch"
			       visible="{cvar.ui_om_hud_im_menu != 0}"/>
		</template>
	</templates>

	<vars>
		<var id="color-hud-friendly" value="#80FF80FF"/>
		<var id="color-hud-enemy" value="#FF8080FF"/>
	</vars>
</ui-library>
